---
import { ui } from '../lib/ui'
import type { Locale } from '../lib/sanity'
const { locale } = Astro.props as { locale: Locale }
---
<div class="cookie-banner" id="cookieBanner" hidden>
  <h2 class="cookie-banner__title">{ui('cookieTitle', locale)}</h2>
  <p class="cookie-banner__text">{ui('cookieText', locale)}</p>
  <div class="cookie-banner__actions">
    <button type="button" class="cookie-banner__btn" data-cookie="accepted">{ui('cookieAccept', locale)}</button>
    <button type="button" class="cookie-banner__btn" data-cookie="declined">{ui('cookieDecline', locale)}</button>
  </div>
  <button type="button" class="cookie-banner__prefs" data-cookie="declined">{ui('cookiePrefs', locale)}</button>
</div>

<script is:inline>
  (function () {
    var KEY = 'hd-cookie-consent';
    var el = document.getElementById('cookieBanner');
    if (!el) return;
    try { if (!localStorage.getItem(KEY)) el.hidden = false; } catch (e) { el.hidden = false; }
    el.querySelectorAll('[data-cookie]').forEach(function (b) {
      b.addEventListener('click', function () {
        try { localStorage.setItem(KEY, b.getAttribute('data-cookie')); } catch (e) {}
        el.hidden = true;
      });
    });
  })();
</script>
