---
import { imgUrl, imgAlt } from '../../lib/content'
import type { Locale } from '../../lib/sanity'
const { block, locale } = Astro.props as { block: any; locale: Locale }
const slides = (block.slides ?? []).map((s: any) => ({ url: imgUrl(s, 1600), alt: imgAlt(s, locale) })).filter((s: any) => s.url)
---
{slides.length > 0 && (
  <section class="content-section content-section--alternate has-slider hd-slider-wrap">
    <div class="hd-slider" data-slider>
      {slides.map((s: any, i: number) => (
        <div class={`hd-slide ${i === 0 ? 'is-active' : ''}`} style={`background-image:url('${s.url}')`} role="img" aria-label={s.alt} />
      ))}
    </div>
  </section>
)}
