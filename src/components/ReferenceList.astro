---
import { t, pt, imgUrl, slugOf, imgAlt } from '../lib/content'
import { ui } from '../lib/ui'
import type { Locale } from '../lib/sanity'
const { refs = [], locale } = Astro.props as { refs: any[]; locale: Locale }
---
<div class="ref-wrap">
  {refs.map((r: any) => {
    const slug = slugOf(r, locale)
    // Zonder slug bouwt [...slug].astro geen detailpagina, en wees de link naar
    // /referenties/ — het overzicht waar je al stond. Dat overkwam Morrow Eyewear.
    // Liever geen link dan een link die stilstaat: het blok blijft staan, alleen de
    // doorklik verdwijnt tot de slug in de Studio ingevuld is.
    const url = slug ? `/${locale}/referenties/${slug}` : null
    const title = t(r.title, locale)
    const logo = imgUrl(r.logo, 600)
    return (
      <div class="ref__block">
        <div class="ref__block__logo">
          {url && <a class="overlay-link" href={url} title={title}></a>}
          {logo && <div class="ref-logo"><img src={logo} alt={imgAlt(r.logo, locale, title)} /></div>}
        </div>
        <div class="ref__block__slider">
          {url && <a class="overlay-link" href={url} title={title}></a>}
          <div class="ref-slider" data-slider>
            {(r.photos ?? []).map((p: any) => {
              const src = imgUrl(p, 800)
              return src ? <div class="ref-slider__item"><img src={src} alt="" /></div> : null
            })}
          </div>
        </div>
        <div class="ref__block__info">
          {url ? <a href={url} title={title}><h3>{title}</h3></a> : <h3>{title}</h3>}
          <div class="page-content" set:html={pt(r.description, locale)} />
          {url && (
            <a href={url} title={title} class="more"><i class="fa fa-angle-double-right"></i> {ui('leesMeer', locale)}</a>
          )}
        </div>
      </div>
    )
  })}
</div>
