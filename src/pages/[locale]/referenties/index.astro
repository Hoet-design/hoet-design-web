---
import Base from '../../../layouts/Base.astro'
import ReferenceList from '../../../components/ReferenceList.astro'
import { LOCALES, getReferences, type Locale } from '../../../lib/sanity'
import { ui } from '../../../lib/ui'
export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }))
}
const locale = Astro.params.locale as Locale
const refs = await getReferences()
const langUrls = Object.fromEntries(LOCALES.map((l) => [l, `/${l}/referenties`]))
---
<Base locale={locale} title={ui('referenties', locale)} description={ui('referentiesDesc', locale)} langUrls={langUrls}>
  <section class="content-section content-section--white">
    <div class="row"><div class="columns">
      <h1 class="main__title">{ui('referenties', locale)}</h1>
      <div class="section">
        <ReferenceList refs={refs} locale={locale} />
      </div>
    </div></div>
  </section>
</Base>
