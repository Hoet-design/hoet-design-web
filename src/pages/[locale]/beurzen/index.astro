---
import Base from '../../../layouts/Base.astro'
import { LOCALES, getFairs, type Locale } from '../../../lib/sanity'
import { t, imgUrl, imgAlt } from '../../../lib/content'
import { ui } from '../../../lib/ui'
export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }))
}
const locale = Astro.params.locale as Locale
const fairs = await getFairs()
const langUrls = Object.fromEntries(LOCALES.map((l) => [l, `/${l}/beurzen`]))
---
<Base locale={locale} title={ui('beurzen', locale)} description={ui('beurzenDesc', locale)} langUrls={langUrls}>
  <section class="content-section content-section--white">
    <div class="row"><div class="columns">
      <h1 class="main__title">{ui('beurzen', locale)}</h1>
      {fairs.length === 0 ? (
        <p class="page-content" style="text-align:center;opacity:.7;">{ui('geenBeurzen', locale)}</p>
      ) : (
        fairs.map((f: any) => (
          <div class="row fair">
            <div class="columns medium-4">{imgUrl(f.logo, 500) && <img class="fair__logo" src={imgUrl(f.logo, 500)} alt={imgAlt(f.logo, locale, t(f.title, locale))} />}</div>
            <div class="columns medium-8">
              <h2 class="fair__title">{t(f.title, locale)}</h2>
              {t(f.subtitle, locale) && <p class="fair__subtitle">{t(f.subtitle, locale)}</p>}
              {t(f.description, locale) && <p set:html={t(f.description, locale).replace(/\n/g, '<br>')} />}
            </div>
          </div>
        ))
      )}
    </div></div>
  </section>
</Base>
