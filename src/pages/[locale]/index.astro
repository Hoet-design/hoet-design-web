---
import Base from '../../layouts/Base.astro'
import ReferenceList from '../../components/ReferenceList.astro'
import { LOCALES, getPage, getReferences, type Locale } from '../../lib/sanity'
import { t } from '../../lib/content'
import { ui } from '../../lib/ui'
import { HOME_INTRO } from '../../lib/home'
export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }))
}
const locale = Astro.params.locale as Locale
const page = await getPage('Home')
const refs = await getReferences()
const title = t(page?.seo?.metaTitle, locale) || t(page?.title, locale)
const description = t(page?.seo?.metaDescription, locale)
const langUrls = Object.fromEntries(LOCALES.map((l) => [l, `/${l}`]))
const intro = HOME_INTRO[locale]
const br = (s: string) => s.split('\n').join('<br>')
---
<Base locale={locale} title={title} description={description} langUrls={langUrls}>
  {/* Full-height video hero ABOVE the nav (so the menu sits at the bottom of the first screen, like the live) */}
  <div slot="hero" class="hd-hero-wrap">
    <section class="hd-home-hero">
      <video id="mainVideo" loop muted playsinline preload="none" poster="/media/home-hero-poster.jpg">
        <source src="/media/home-hero.mp4" type="video/mp4" />
      </video>
      <a href="javascript:;" class="play-button js-play-button" aria-label="Play"><div class="play-button__inner"><i class="fa fa-play"></i></div></a>
      <a href="javascript:;" class="scroll-down js-scroll-down" aria-label="Scroll"><i class="fa fa-angle-double-down"></i></a>
    </section>
  </div>

  {/* Intro (centred), ported from the live home */}
  <section id="homeContent" class="content-section content-section--white">
    <div class="row"><div class="columns">
      <h1 class="main__title hero" set:html={br(intro.title)} />
      <div class="page-content intro-home">
        <div style="text-align:center;" set:html={br(intro.para1)} />
        <p>&nbsp;</p>
        {intro.h2 && <h2 style="text-align:center;" set:html={br(intro.h2)} />}
        <div style="text-align:center;" set:html={br(intro.para2)} />
      </div>
    </div></div>
  </section>

  {/* References (same blocks as /referenties) */}
  <section class="content-section content-section--white">
    <div class="row"><div class="columns">
      <h1 class="main__title">{ui('referenties', locale)}</h1>
      <div class="section">
        <ReferenceList refs={refs} locale={locale} />
      </div>
    </div></div>
  </section>

  <script is:inline>
    (function () {
      var video = document.getElementById('mainVideo');
      var hero = document.querySelector('.hd-home-hero');
      var play = document.querySelector('.js-play-button');
      var icon = play && play.querySelector('i');
      if (video && play) {
        play.addEventListener('click', function (e) {
          e.preventDefault();
          if (video.paused) { video.muted = false; video.play(); } // play with sound
          else { video.pause(); }
        });
        video.addEventListener('play', function () { if (icon) icon.className = 'fa fa-pause'; if (hero) hero.classList.add('is-playing'); });
        video.addEventListener('pause', function () { if (icon) icon.className = 'fa fa-play'; if (hero) hero.classList.remove('is-playing'); });
      }
      var down = document.querySelector('.js-scroll-down');
      if (down) down.addEventListener('click', function (e) {
        e.preventDefault();
        var hero = document.querySelector('.hd-hero-wrap');
        var y = hero ? hero.getBoundingClientRect().bottom + window.scrollY : window.innerHeight;
        window.scrollTo({ top: y, behavior: 'smooth' });
      });
    })();
  </script>
</Base>
