---
import { getPages, getSettings, LOCALES, type Locale } from '../lib/sanity'
import { t, slugOf, imgUrl, imgAlt } from '../lib/content'
import { ui } from '../lib/ui'
import CookieBanner from '../components/CookieBanner.astro'

interface Props {
  locale: Locale
  title?: string
  description?: string
  langUrls?: Partial<Record<Locale, string>> // per-locale URL of the current page
  isHome?: boolean // home hero sits under the fixed nav (no top offset)
}
const { locale, title, description, langUrls, isHome } = Astro.props

const pages = await getPages()
const settings = await getSettings()
const byName = (n: string) => pages.find((p: any) => p.internalName === n)

const home = byName('Home')
const visie = byName('Onze visie')
const historie = byName('Historie & Werkwijze')
const contact = byName('Contact')

const pUrl = (p: any, fallback: string) => (p ? `/${locale}/${slugOf(p, locale)}` : fallback)
const nav = [
  { label: t(home?.title, locale) || 'Home', url: `/${locale}` },
  { label: t(visie?.title, locale) || 'Onze visie', url: pUrl(visie, '#') },
  { label: t(historie?.title, locale) || 'Historie & Werkwijze', url: pUrl(historie, '#') },
  { label: ui('referenties', locale), url: `/${locale}/referenties` },
  { label: ui('beurzen', locale), url: `/${locale}/beurzen` },
  { label: t(contact?.title, locale) || 'Contact', url: pUrl(contact, `/${locale}/contact`) },
]

// mark the current nav item active (home = exact, others = section prefix)
const current = Astro.url.pathname.replace(/\/+$/, '') || `/${locale}`
const isActive = (url: string) => {
  const u = url.replace(/\/+$/, '')
  if (u === `/${locale}`) return current === `/${locale}`
  return current === u || current.startsWith(u + '/')
}

const favicon = imgUrl(settings?.favicon, 64, 64)
const footerImg = settings?.footerImage
// full (uncropped) image for the site-wide contact CTA background
const ctaBg = footerImg?.asset ? imgUrl({ _type: 'image', asset: footerImg.asset }, 1950) : null
const metaTitle = title ? `${title} — Hoet Design` : 'Hoet Design'

// ---- SEO: absolute URLs, canonical, hreflang, Open Graph, JSON-LD ----
const SITE = (Astro.site?.href || 'https://www.hoet-design.com/').replace(/\/$/, '')
const abs = (p: string) => SITE + (p.startsWith('/') ? p : '/' + p)
const canonicalPath = (langUrls?.[locale] ?? Astro.url.pathname.replace(/\/+$/, '')) || `/${locale}`
const canonical = abs(canonicalPath)
const ogImage = abs('/media/home-hero-poster.jpg')
const ogLocale = ({ nl: 'nl_BE', fr: 'fr_BE', de: 'de_DE', en: 'en_US' } as Record<string, string>)[locale] || 'nl_BE'
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Hoet Eyewear Design',
  url: SITE,
  logo: abs('/theme/images/skin/default/logo-hoet.png'),
  email: 'info@hoet.be',
  telephone: '+32 50 33 43 02',
  address: { '@type': 'PostalAddress', streetAddress: 'Klaverstraat 71', postalCode: '8000', addressLocality: 'Brugge', addressCountry: 'BE' },
}
---
<!doctype html>
<html lang={locale} class={`modernbrowser ${locale}`}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{metaTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  {LOCALES.map((l) => langUrls?.[l] && <link rel="alternate" hreflang={l} href={abs(langUrls[l]!)} />)}
  {langUrls?.nl && <link rel="alternate" hreflang="x-default" href={abs(langUrls.nl)} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Hoet Design" />
  <meta property="og:title" content={metaTitle} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={metaTitle} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  <link rel="icon" type="image/x-icon" href={favicon ?? '/favicon.ico?v=2'} />
  <link rel="shortcut icon" href="/favicon.ico?v=2" />
  {favicon && <link rel="apple-touch-icon" href={favicon} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css?family=Quicksand:300,400,700" rel="stylesheet" />
  <link rel="stylesheet" href="/theme/css/compiled.min.css" />
  <link rel="stylesheet" href="/theme/css/custom.css" />
</head>
<body>
  <slot name="hero" />
  <header>
    <div class="header">
      <div class="row"><div class="columns medium-12 no-relative">
        <div class="show-mobile">
          <div class="logo-link"><h1 class="logo"><a href={`/${locale}`} title="Hoet Design">Hoet Design</a></h1></div>
          <a href="tel:+3250334302" class="mobile-nav-icon phone-icon" aria-label="Bel ons"><i class="fa fa-phone"></i></a>
          <a href="javascript:;" data-panel="nav" class="mobile-nav-icon nav-icon js-nav-toggle"><i class="fa fa-navicon"></i></a>
        </div>
      </div></div>
    </div>

    <div class="base-lang-wrap">
      {LOCALES.map((l) => (
        <a href={langUrls?.[l] ?? `/${l}`} class={`lang__item ${l === locale ? 'active' : ''}`}>{l}</a>
      ))}
    </div>

    <div class="sticky-wrapper">
      <nav class="navigation mobile-height">
        <div class="row collapse"><div class="columns relative-block">
          <h1 class="logo"><a href={`/${locale}`} title="Hoet Design">Hoet Design</a></h1>
          <ul class="nav">
            {nav.map((item) => (
              <li class={`nav__item ${isActive(item.url) ? 'active' : ''}`}><a href={item.url} title={item.label}>{item.label}</a></li>
            ))}
          </ul>
        </div></div>
      </nav>
    </div>
  </header>

  <div class="main-content-wrap"><div class="main-wrap"><div id="mainContentWrap">
    <slot />
  </div></div></div>

  {/* Site-wide contact CTA (like the live, above the footer) */}
  <section class="content-section content-section--cta-contact" style={ctaBg ? `background-image:url('${ctaBg}')` : undefined}>
    <div class="contact-cta-block">
      <h2 class="main__title hero way-point">{ui('contactTitle', locale)}</h2>
      <div class="row way-point">
        <div class="columns medium-6"><div class="contact-cta-info sep"><i class="fa fa-phone"></i><a href="tel:+3250334302">+32 (0) 50 33 43 02</a></div></div>
        <div class="columns medium-6"><div class="contact-cta-info"><i class="fa fa-envelope"></i><a href="mailto:info@hoet.be">info@hoet.be</a></div></div>
      </div>
      <div class="contact-cta-bottom way-point">
        <div class="row"><div class="columns text-center">
          <a class="btn btn--border--white" href={`/${locale}/contact`}>{ui('offerteBtn', locale)}</a>
        </div></div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="bottombar mobile-center"><div class="row"><div class="columns large-12">
      <div class="footer-list">
        <span class="footer-list-item">&copy; Hoet nv {new Date().getFullYear()}</span>
        <a href={`/${locale}/voorwaarden`} class="footer-list-item">Voorwaarden</a>
        <a href={`/${locale}/privacy`} class="footer-list-item">privacy</a>
        <a href={`/${locale}/imprint`} class="footer-list-item">imprint</a>
      </div>
    </div></div></div>
  </footer>

  <CookieBanner locale={locale} />

  <script is:inline>
    // mobile nav toggle (body[data-panel='nav']) — no jQuery
    document.querySelectorAll('.js-nav-toggle').forEach(function (b) {
      b.addEventListener('click', function (e) {
        e.preventDefault();
        var on = document.body.getAttribute('data-panel') === 'nav';
        document.body.setAttribute('data-panel', on ? '' : 'nav');
      });
    });
    // sticky desktop nav: .stuck when the nav bar reaches the top (like the live).
    // On the home it sits below the hero and sticks on scroll; on inner pages it is at
    // the top so it sticks immediately. The wrapper holds the nav height to avoid a jump.
    (function () {
      var wrap = document.querySelector('.sticky-wrapper');
      if (!wrap) return;
      var nav = wrap.querySelector('.navigation');
      var threshold = 0, navH = 0;
      var isDesktop = function () { return window.innerWidth > 1130; };
      var onScroll = function () {
        if (!isDesktop()) { nav.classList.remove('stuck'); wrap.style.height = ''; return; }
        if (window.scrollY >= threshold) { nav.classList.add('stuck'); wrap.style.height = navH + 'px'; }
        else { nav.classList.remove('stuck'); wrap.style.height = ''; }
      };
      var measure = function () {
        nav.classList.remove('stuck'); wrap.style.height = '';
        threshold = wrap.offsetTop; navH = nav.offsetHeight;
        onScroll();
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', measure);
      measure();
    })();
    // fade sliders ([data-slider]) — replaces slick, one slide visible at a time
    document.querySelectorAll('[data-slider]').forEach(function (sl) {
      var items = sl.querySelectorAll('.ref-slider__item, .hd-slide');
      if (items.length < 1) return;
      var i = 0;
      items[0].classList.add('is-active');
      if (items.length < 2) return;
      setInterval(function () {
        items[i].classList.remove('is-active');
        i = (i + 1) % items.length;
        items[i].classList.add('is-active');
      }, 4000);
    });
    // scroll-reveal: add .in-view to .way-point elements when they enter the viewport (like the live)
    (function () {
      var wps = document.querySelectorAll('.way-point');
      if (!wps.length) return;
      if (!('IntersectionObserver' in window)) { wps.forEach(function (el) { el.classList.add('in-view'); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } });
      }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
      wps.forEach(function (el) { io.observe(el); });
    })();
  </script>
</body>
</html>
